# Guide — copy same values from ThinkAbroad .env / Render.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+XXXXXXXXXXX

GUIDE_PUBLIC_URL=https://YOUR-GUIDE-SERVICE.onrender.com
GUIDE_DB_PATH=/var/data/guide.db

# Chat + CV
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Live job search (Google Search grounding) — ThinkAbroad uses Gemini_API_KEY
GEMINI_API_KEY=
# or: Gemini_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

VAULT_SECRET_KEY=
LOG_LEVEL=INFO

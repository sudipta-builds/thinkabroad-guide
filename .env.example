# Guide — WhatsApp travel agent.

# Meta WhatsApp Cloud API (preferred)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=guide_wa_verify_2026
GRAPH_API_VERSION=v21.0
META_APP_SECRET=

# Twilio WhatsApp (legacy fallback — optional if Meta is set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+XXXXXXXXXXX

GUIDE_PUBLIC_URL=https://thinkabroad-guide.onrender.com
GUIDE_DB_PATH=/var/data/guide.db

# Chat + CV
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Live job search (Google Search grounding) — ThinkAbroad uses Gemini_API_KEY
GEMINI_API_KEY=
# or: Gemini_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Screenshot vision on every booking step (default on when GEMINI_API_KEY is set). GUIDE_VISION=0 to disable.
# GUIDE_VISION=1

VAULT_SECRET_KEY=
LOG_LEVEL=INFO

# Indian residential proxy for booking Chromium on Render (DataImpulse).
# Booking/checkout uses this only (no datacenter Cleartrip fallback).
# USERNAME must be LOGIN__cr.in;sessttl.30 — sticky port 10000-20000, not 823.
PROXY_HOST=gw.dataimpulse.com
PROXY_PORT=10000
PROXY_USERNAME=
PROXY_PASSWORD=
# Set PROXY_SEARCH=1 only if search must also use the proxy (costs more GB)
# PROXY_SEARCH=0

# Hetzner Chromium worker (Render should set these; VPS sets PROXY_* + BOOKING_WORKER_TOKEN)
# BOOKING_WORKER_URL=http://YOUR_HETZNER_IP:8000
# BOOKING_WORKER_TOKEN=

# Kernel cloud Chrome (Ixigo stealth PoC: python scripts/ixigo_kernel_poc.py)
# https://www.kernel.sh — free tier includes stealth. Do not commit the key.
# KERNEL_API_KEY=
# KERNEL_IXIGO_PROFILE=guide-ixigo

# Browserbase cloud Chrome (smoke: python scripts/browserbase_smoke_cleartrip.py)
# Free plan: key only. India proxy needs Developer + BROWSERBASE_USE_INDIA=1
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_USE_INDIA=0

# Bright Data Browser API (preferred free India test)
# Zone Overview username + password — NOT the account API key alone.
# smoke: python scripts/brightdata_smoke_cleartrip.py
# BRIGHTDATA_BROWSER_USER=brd-customer-XXXXX-zone-YYYYY
# BRIGHTDATA_BROWSER_PASSWORD=
# BRIGHTDATA_USE_INDIA=1
# optional one-liner instead of user+password:
# BRIGHTDATA_AUTH=brd-customer-XXXXX-zone-YYYYY:password

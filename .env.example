# Guide — WhatsApp only. Paste the SAME Twilio values you use for ThinkAbroad.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+XXXXXXXXXXX

GUIDE_PUBLIC_URL=https://YOUR-GUIDE-SERVICE.onrender.com
GUIDE_DB_PATH=/var/data/guide.db

# LLM — Gemini is best for live job search (Google Search grounding).
# DeepSeek is best/cheap for chat + CV drafting. Guide uses both when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback web search if Gemini grounding is unavailable (same Brave key as ThinkAbroad is fine)
BRAVE_API_KEY=

# Encrypts LinkedIn/ATS passwords in Guide's vault (any long random string, 32+ chars)
VAULT_SECRET_KEY=

LOG_LEVEL=INFO

# Guide — WhatsApp only. Same Twilio / DeepSeek / Brave values as ThinkAbroad.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+XXXXXXXXXXX

GUIDE_PUBLIC_URL=https://YOUR-GUIDE-SERVICE.onrender.com
GUIDE_DB_PATH=/var/data/guide.db

# Chat + CV (DeepSeek only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Live job search (Brave only)
BRAVE_API_KEY=

# Encrypts LinkedIn/ATS passwords in Guide's vault
VAULT_SECRET_KEY=

LOG_LEVEL=INFO
